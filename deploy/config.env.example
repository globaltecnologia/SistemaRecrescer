# Copie para deploy/config.env e preencha. Nunca versione config.env.

AWS_PROFILE=recrescer
AWS_REGION=us-west-2
APP_NAME=sistema-recrescer
ENVIRONMENT=prod
LAMBDA_RESERVED_CONCURRENCY=10

# Provisionamento Aiven gratuito. Nesta conta, o free tier aceita DigitalOcean/UpCloud.
AIVEN_PROJECT=recrescer
AIVEN_SERVICE=recrescer-mysql
AIVEN_CLOUD=do-nyc
AIVEN_PLAN=free-1-1gb

# Frontend estático no Cloudflare Pages.
CLOUDFLARE_PAGES_PROJECT=sistema-recrescer
CLOUDFLARE_PRODUCTION_BRANCH=main
CLOUDFLARE_PAGES_DOMAIN=sistema-recrescer.pages.dev
# Opcional: substitui a Function URL obtida da stack AWS.
FRONTEND_API_URL=

# MySQL gerenciado e acessível pela internet usando TLS.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=recrescer
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_SSL_MODE=required
# Conteúdo PEM do CA convertido com: base64 -w0 ca.pem
MYSQL_SSL_CA_BASE64=

# Credenciais iniciais usadas somente se a tabela users estiver vazia.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Origem do frontend, por exemplo https://app.exemplo.com.
CORS_ORIGIN=*
